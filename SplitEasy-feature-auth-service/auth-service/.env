# Archivo: .env.example
# Propósito: Variables documentadas en español usadas en el servidor auth.

# Cadena de conexión postgres
DATABASE_URL=postgres://usuario:contraseña@servidor:puerto/base_de_datos

# Puerto donde levanta Fastify internamente
# PORT=3001

# Llave privada de signado y resolución de JSON Web Tokens
JWT_SECRET=12345

# Llave de compaginado en encriptación para fastify-cookie
#COOKIE_SECRET=reemplazar_con_firma_cookies_aqui
